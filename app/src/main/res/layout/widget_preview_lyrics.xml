<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher picker preview for the Rhythm Lyrics widget.
     Framework-safe only (android:* attributes, no app: namespace, no compound
     drawables) so launchers can inflate it reliably and render it dark. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,UseCompoundDrawables"
    android:layout_width="250dp"
    android:layout_height="140dp">

    <ImageView
        android:importantForAccessibility="no"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_preview_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Brand row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:importantForAccessibility="no"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_notification"
                android:tint="@color/widget_preview_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/widget_preview_brand"
                android:textColor="@color/widget_preview_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_title"
            android:textColor="@color/widget_preview_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_subtitle"
            android:textColor="@color/widget_preview_subtext"
            android:textSize="12sp"
            android:layout_marginTop="1dp" />

        <!-- Active lyric line (highlighted) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_lyric_active"
            android:textColor="@color/widget_preview_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <!-- Next lyric line (dim) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_lyric_next"
            android:textColor="@color/widget_preview_surface_variant"
            android:textSize="12sp"
            android:layout_marginTop="1dp" />

        <!-- Controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="8dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_circle"
                    android:tint="@color/widget_preview_tertiary" />

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_skip_previous"
                    android:tint="@color/widget_preview_on_tertiary" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp">

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_pill"
                    android:tint="@color/widget_preview_primary" />

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="@color/widget_preview_on_primary" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp">

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_circle"
                    android:tint="@color/widget_preview_tertiary" />

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_skip_next"
                    android:tint="@color/widget_preview_on_tertiary" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
